rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Collection: Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || userId == incoming().id);
    }

    // 3. Collection: Chats
    match /chats/{chatId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(chatId);
      allow update: if isSignedIn() && isValidId(chatId);
      allow delete: if isSignedIn() && isValidId(chatId);
    }

    // 4. Collection: Messages
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(messageId) && incoming().senderId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(messageId);
      allow delete: if isSignedIn() && isValidId(messageId) && existing().senderId == request.auth.uid;
    }
  }
}
